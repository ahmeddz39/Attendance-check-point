{
  "name": "attendance-check-point",
  "version": "1.0.0",
  "description": "Internal employee attendance, biometric device sync, and payroll dashboard",
  "main": "backend/src/server.js",
  "scripts": {
    "dev": "nodemon backend/src/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "start": "node backend/src/server.js",
    "db:migrate": "node backend/src/config/migrate.js",
    "db:seed": "node backend/src/config/seed.js",
    "db:create-admin": "node backend/src/config/createAdmin.js",
    "build": "cd frontend && npm run build",
    "prod:start": "pm2 start ecosystem.config.js",
    "prod:restart": "pm2 restart attendance-app",
    "prod:stop": "pm2 stop attendance-app",
    "prod:logs": "pm2 logs attendance-app",
    "deploy:windows": "powershell -ExecutionPolicy Bypass -File deploy/setup-windows.ps1",
    "deploy:linux": "bash deploy/setup-vm.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.11.0",
    "uuid": "^9.0.0",
    "zklib-js": "^1.3.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.0"
  }
}
